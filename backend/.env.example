PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_management
DB_USER=root
DB_PASS=your_mysql_password

JWT_SECRET=generate_a_strong_random_secret_here
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────
# Use SQLite instead of MySQL (no database server needed; used for the AWS deploy)
# DB_DIALECT=sqlite
# DB_STORAGE=./data/gym.sqlite

# Seed demo data automatically when the database is empty
# AUTO_SEED=true

# Restore the demo data every N hours (for public demos)
# DEMO_RESET_HOURS=24

# Set to true once the site is served over HTTPS
# ENABLE_HSTS=false
